{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "position: sticky",
          "backdrop-filter",
          "padding-inline",
          "inset",
          "inset: auto 0 0 0",
          "scroll-behavior",
          "scroll-behavior: smooth"
        ]
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]"
        ]
      }
    ]
  }
}